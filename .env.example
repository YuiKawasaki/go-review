# ---- Notion（Phase 0 で取得する5つ）
NOTION_TOKEN=ntn_xxxxxxxxxxxx
NOTION_VERSION=2025-09-03
KIFU_DS_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
LOG_DS_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
OLD_DS_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
KIFU_DB_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ---- 本人（PB/PW との照合に使う）
MY_PLAYER_NAME=wakame_han

# ---- KataGo（Phase 0.5 で導入）
KATAGO_EXE=C:\go-review\katago\katago.exe
KATAGO_MODEL=C:\go-review\katago\model.bin.gz
KATAGO_CONFIG=C:\go-review\katago\analysis.cfg
KATAGO_THREADS=2
PASS1_VISITS=150
PASS2_VISITS=1500
QUICK_VISITS=100
MAX_RUNTIME_MINUTES=120

# ---- 悪手判定の閾値（九路盤は 1 手の価値が大きいため高めに設定）
DUBIOUS_THRESHOLD=10
BAD_THRESHOLD=20
CRITICAL_THRESHOLD=30
MAX_PROBLEMS_PER_GAME=3
ACCEPTABLE_DELTA=5
DAILY_REVIEW_LIMIT=10

# ---- Claude API（未設定ならテンプレートで解説文を生成します）
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5
CLAUDE_ENABLED=true

# ---- 配信（GitHub Pages / Cloudflare Pages などの公開先）
# PUBLISH_DIR=C:\go-review\publish
# PUBLISH_SLUG=r7f3k9x2
# REVIEW_BASE_URL=https://example.github.io/go-review

# ---- データ置き場（既定は %LOCALAPPDATA%\go-review。OneDrive の外に置くこと）
# GOREVIEW_DATA_DIR=C:\go-review\data
LOCAL_SERVER_PORT=8777
